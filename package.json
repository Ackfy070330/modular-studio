{
  "name": "modular-studio",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && npm run desktop:open",
    "desktop:open": "node node_modules/electron/install.js && electron desktop",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@xyflow/react": "^12.8.0",
    "blockly": "^12.3.0",
    "fastify": "^5.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "模序 · 可视化模块开发与数据流调试工作台",
  "author": "Ackfy070330",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ackfy070330/modular-studio.git"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
